{
  "name": "@local/dsh-desktop-extras",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Git worktrees, a headed Playwright browser, and native desktop control for this DSH profile.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
