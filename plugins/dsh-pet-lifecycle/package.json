{
  "name": "@dsh-pet/lifecycle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "桌面桌宠生命周期控制：DSH 启动时拉起 dsh-pet，DSH 退出时关闭它",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
